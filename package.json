{
	"name": "seestar-mcp",
	"version": "0.1.0",
	"description": "MCP server for ZWO Seestar telescopes over ASCOM Alpaca",
	"keywords": [
		"mcp",
		"model-context-protocol",
		"seestar",
		"ascom",
		"alpaca",
		"astronomy",
		"telescope"
	],
	"license": "MIT",
	"author": "Alex Khizhnyi",
	"type": "module",
	"bin": "dist/index.js",
	"main": "./dist/index.js",
	"files": [
		"dist",
		"/README.md",
		"/LICENSE"
	],
	"engines": {
		"node": ">=20.3"
	},
	"scripts": {
		"build": "tsc -p tsconfig.json",
		"dev": "tsx src/index.ts",
		"typecheck": "tsc -p tsconfig.test.json",
		"lint": "biome check .",
		"lint:fix": "biome check --write .",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:coverage": "vitest run --coverage",
		"inspect": "yarn build && yarn dlx @modelcontextprotocol/inspector node dist/index.js",
		"prepublishOnly": "yarn build",
		"sim:fetch": "node scripts/fetch-omnisim.mjs",
		"test:sim": "node scripts/fetch-omnisim.mjs && vitest run --config vitest.sim.config.ts"
	},
	"dependencies": {
		"@modelcontextprotocol/server": "^2.0.0",
		"zod": "^4.0.0"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.3.0",
		"@modelcontextprotocol/client": "^2.0.0",
		"@types/node": "^24.0.0",
		"@vitest/coverage-v8": "^4.1.0",
		"tsx": "^4.19.0",
		"typescript": "^5.9.0",
		"vitest": "^4.1.0"
	},
	"packageManager": "yarn@4.18.0",
	"publishConfig": {
		"access": "public"
	}
}
